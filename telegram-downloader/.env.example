# =============================================================================
# Telegram Direct File Downloader - Environment Configuration Template
# =============================================================================

# 1. Telegram Bot Token (from @BotFather)
# REQUIRED: Must be a valid bot token.
TELEGRAM_BOT_TOKEN=

# 2. Telegram Bot Username
TELEGRAM_BOT_USERNAME=techieverifybot

# 3. Default Channel to resolve (optional)
DEFAULT_CHANNEL=@techiemuthuraj

# 4. Service HTTP Port & Base URL
PORT=5000
BASE_URL=http://localhost:5000

# 5. Security & Token HMAC Secret
# Used to sign short-lived direct download URLs without exposing the Telegram Bot Token
SECRET_KEY=telegram-direct-downloader-secret-2026

# 6. Direct Stream Configuration
STREAM_CHUNK_SIZE=65536
DOWNLOAD_TIMEOUT_MS=60000
PORTAL_URL=https://techiefile.netlify.app/

# 7. Optional: Self-Hosted Telegram Bot API Server URL
# Telegram Cloud Bot API restricts getFile to 20MB.
# Set this if you run your own Telegram Bot API Server (enables up to 2,000MB / 2GB files)
# TELEGRAM_API_ROOT=http://localhost:8081
